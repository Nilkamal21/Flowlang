{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Flowlang",
  "scopeName": "source.flowlang",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#booleans" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.flowlang",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.flowlang",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.flowlang",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.flowlang",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.flowlang",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.flowlang",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.flowlang",
          "match": "\\b(when|otherwise)\\b"
        },
        {
          "name": "keyword.control.declaration.flowlang",
          "match": "\\b(let|define|give|show)\\b"
        },
        {
          "name": "keyword.control.pipeline.flowlang",
          "match": "\\b(keep|where|transform|into|using)\\b"
        },
        {
          "name": "keyword.operator.logical.flowlang",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.flowlang",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.assignment.flowlang",
          "match": "<-"
        },
        {
          "name": "keyword.operator.comparison.flowlang",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.flowlang",
          "match": "(\\+|\\-|\\*|/|%)"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.declaration.flowlang" },
            "2": { "name": "entity.name.function.flowlang" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.call.flowlang" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.flowlang",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.flowlang",
          "match": "(:|,)"
        },
        {
          "name": "punctuation.section.parens.flowlang",
          "match": "(\\(|\\))"
        },
        {
          "name": "punctuation.section.brackets.flowlang",
          "match": "(\\[|\\])"
        }
      ]
    }
  }
}
